# Copy this file to .env.local and fill in your values
# VITE_ prefix is required for Vite to expose these to the browser

# ── Keycloak ──────────────────────────────────────────────────────────────────
# The public URL of your server (IP or domain)
VITE_KEYCLOAK_URL=https://10.240.138.254
VITE_KEYCLOAK_REALM=scenariobuilder
VITE_KEYCLOAK_CLIENT_ID=scenario-builder-api-frontend

# ── Dev proxy target (used only by vite.config.js, NOT exposed to the browser)
# Vite proxies all /api/... requests to this base URL.
# nginx on the server then routes internally to backend and LLM service.
VITE_SERVER_BASE=https://10.240.138.254

# ── LLM service base URL (browser-side axios, leave as /api for Vite proxy) ──
# In production (nginx routes /api → LLM service) also leave as /api.
# Only change if you are calling the LLM service directly without any proxy.
VITE_LLM_API_URL=/api

# ── Branding ──────────────────────────────────────────────────────────────────
# Project display name shown in navbar, sidebar, homepage, and document footers.
# Change this per deployment (e.g. SAFE, GAANDALF, SHIELD, etc.)
VITE_APP_NAME=SAFE
VITE_APP_SUBTITLE=Cyber Training Platform
VITE_APP_VERSION=1.0.0
